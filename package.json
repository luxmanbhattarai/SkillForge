{
  "bin": {
    "skillforge": "scripts/install-skills.mjs"
  },
  "description": "A universal, production-grade AI Agent Skills library covering software engineering, frontend/backend, databases, auth, infrastructure, SEO, content, and media.",
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "name": "skillforge",
  "private": true,
  "scripts": {
    "check:agents": "node scripts/check-agents-workflows.mjs",
    "check:duplicates": "node scripts/check-duplicates.mjs",
    "check:frontmatter": "node scripts/check-frontmatter.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:security": "node scripts/security-scan.mjs",
    "check:sources": "node scripts/check-sources.mjs",
    "evals": "node evals/runners/run-evals.mjs",
    "evals:generate": "node evals/datasets/generate-discovery-cases.mjs",
    "install-skills": "node scripts/install-skills.mjs",
    "registry": "node scripts/generate-registry.mjs",
    "report": "node scripts/generate-report.mjs",
    "score": "node scripts/score-skills.mjs",
    "test": "node --test",
    "validate": "node scripts/validate-skills.mjs",
    "validate:strict": "node scripts/validate-skills.mjs --strict"
  },
  "type": "module",
  "version": "1.0.0"
}
