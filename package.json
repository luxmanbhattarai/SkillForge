{
  "name": "skillforge",
  "version": "1.1.0",
  "description": "A universal, production-grade AI Agent Skills library covering software engineering, frontend/backend, databases, auth, infrastructure, SEO, content, and media.",
  "keywords": [
    "agent-skills",
    "ai-agents",
    "claude-code",
    "codex",
    "cursor",
    "seo",
    "software-engineering"
  ],
  "homepage": "https://github.com/luxmanbhattarai/SkillForge#readme",
  "bugs": {
    "url": "https://github.com/luxmanbhattarai/SkillForge/issues"
  },
  "license": "MIT",
  "author": "Luxman Bhattarai",
  "repository": {
    "type": "git",
    "url": "https://github.com/luxmanbhattarai/SkillForge.git"
  },
  "type": "module",
  "private": true,
  "bin": {
    "skillforge": "scripts/install-skills.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "benchmark": "node scripts/generate-benchmark-report.mjs",
    "check:agents": "node scripts/check-agents-workflows.mjs",
    "check:duplicates": "node scripts/check-duplicates.mjs",
    "check:frontmatter": "node scripts/check-frontmatter.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:references": "node scripts/check-references.mjs",
    "check:registry": "node scripts/validate-registry.mjs",
    "check:security": "node scripts/security-scan.mjs",
    "check:sources": "node scripts/check-sources.mjs",
    "check:status": "node scripts/check-status.mjs",
    "check:upstream": "node scripts/check-upstream.mjs",
    "check:upstream:json": "node scripts/check-upstream.mjs --json",
    "check:upstream:record": "node scripts/check-upstream.mjs --record-state",
    "check:upstream:report": "node scripts/check-upstream.mjs --out ai/maintenance/upstream-report.json",
    "disclosure": "node scripts/disclosure-coverage.mjs",
    "evals": "node evals/runners/run-evals.mjs",
    "evals:generate": "node evals/datasets/generate-discovery-cases.mjs",
    "evals:real": "node evals/run-real-model.mjs",
    "freshness": "node scripts/freshness.mjs",
    "history": "node scripts/skill-history.mjs",
    "history:all": "node scripts/skill-history.mjs --all",
    "install-skills": "node scripts/install-skills.mjs",
    "query": "node scripts/query-skills.mjs",
    "registry": "node scripts/generate-registry.mjs",
    "report": "node scripts/generate-report.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "score": "node scripts/score-skills.mjs",
    "test": "node --test",
    "trends": "node scripts/quality-trends.mjs",
    "trends:compare": "node scripts/quality-trends.mjs compare",
    "trends:snapshot": "node scripts/quality-trends.mjs snapshot",
    "validate": "node scripts/validate-skills.mjs",
    "validate:strict": "node scripts/validate-skills.mjs --strict"
  }
}
