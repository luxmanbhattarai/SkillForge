  "properties": {
    "audit": {
      "type": "string"
    },
    "derived": {
      "type": "string"
    },
    "statuses": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": [
              "string",
              "null"
