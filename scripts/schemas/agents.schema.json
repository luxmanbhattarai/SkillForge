{
  "$id": "https://github.com/luxmanbhattarai/SkillForge/schemas/agents.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agents": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "discover": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "references": {
            "additionalProperties": false,
            "properties": {
              "agents": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "workflows": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "agents",
              "workflows"
            ],
            "type": "object"
          },
          "title": {
            "type": "string"
          },
          "use": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "name",
          "title",
          "description",
          "path",
          "discover",
          "use",
          "references"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "generated": {
      "type": "string"
    },
    "total_agents": {
      "type": "integer"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "version",
    "generated",
    "total_agents",
    "agents"
  ],
  "type": "object"
}
